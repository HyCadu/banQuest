<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="packs/" />
        <!-- Sessão de login e estado da sincronização ficam só neste aparelho (token não viaja; id do aparelho é único). -->
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="packs/" />
        <!-- Sessão de login e estado da sincronização ficam só neste aparelho (token não viaja; id do aparelho é único). -->
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
